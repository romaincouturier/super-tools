                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              ],
              "description": "ISO date or datetime, inclusive upper bound on scheduled_at (a date covers the whole day)"
            },
            "status": {
              "type": "string",
              "enum": [
                "scheduled",
                "completed"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
