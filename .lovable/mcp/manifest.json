{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yewffntzgrdgztrwtava.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "supertools",
      "version": "1.0.0",
      "title": "SuperTools"
    },
    "tools": [
      {
        "name": "list_lms_modules",
        "title": "Lister les modules",
        "description": "Liste les modules ordonnés, y compris vides, avec nombre de leçons.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "course_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "course_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_lms_module",
        "title": "Créer un module",
        "description": "Crée un module en fin ou à une position explicite, sans modifier les leçons.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "course_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": {
              "type": "string",
              "maxLength": 10000
            },
            "position": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "course_id",
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_lms_module",
        "title": "Modifier un module",
        "description": "Modifie titre, description ou position avec valeurs avant/après, sans changer les leçons.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "module_id": {
              "type": "string",
              "format": "uuid"
            },
            "patch": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 10000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "module_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "assign_transcript",
        "title": "Rattacher un transcript à une formation",
        "description": "Rattache à une formation ; demander confirmation si déjà lié ailleurs. Les autres cibles restent sur le connecteur historique.",
        "annotations": {
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "transcript_id": {
              "type": "string",
              "format": "uuid"
            },
            "target_type": {
              "type": "string",
              "const": "training"
            },
            "target_id": {
              "type": "string",
              "format": "uuid"
            },
            "allow_multiple": {
              "type": "boolean"
            }
          },
          "required": [
            "transcript_id",
            "target_type",
            "target_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_unassigned_transcripts",
        "title": "Lister les transcripts non affectés",
        "description": "Liste une page de transcripts prêts sans rattachement, formations comprises ; suivre next_offset pour continuer.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "search": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_watch_sources",
        "title": "Lister les sources de veille",
        "description": "Liste les sources de veille avec filtres expert et statut.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "expert": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "to_subscribe",
                "followed",
                "dropped"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "propose_watch_source",
        "title": "Proposer une source de veille",
        "description": "Propose une source canonique sans valider ni abonner automatiquement.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "expert": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "type": {
              "type": "string",
              "enum": [
                "newsletter",
                "podcast",
                "youtube",
                "tiktok",
                "linkedin",
                "blog",
                "revue",
                "site",
                "autre"
              ]
            },
            "language": {
              "type": "string",
              "enum": [
                "fr",
                "en",
                "autre"
              ]
            },
            "theme": {
              "type": "string",
              "maxLength": 255,
              "default": ""
            },
            "why": {
              "type": "string",
              "maxLength": 5000,
              "default": ""
            },
            "how_to_follow": {
              "type": "string",
              "maxLength": 5000,
              "default": ""
            }
          },
          "required": [
            "expert",
            "name",
            "url",
            "type",
            "language"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_watch_source",
        "title": "Modifier une source de veille",
        "description": "Modifie les champs explicitement fournis et retourne avant/après.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "format": "uuid"
            },
            "patch": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "to_subscribe",
                    "followed",
                    "dropped"
                  ]
                },
                "usefulness": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "type": "string",
                  "maxLength": 10000
                },
                "theme": {
                  "type": "string",
                  "maxLength": 255
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "source_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_lms_course",
        "title": "Modifier la couverture d’un cours",
        "description": "Modifie uniquement cover_image_url HTTPS ou null, avec valeurs avant/après.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "course_id": {
              "type": "string",
              "format": "uuid"
            },
            "patch": {
              "type": "object",
              "properties": {
                "cover_image_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "cover_image_url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "course_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
