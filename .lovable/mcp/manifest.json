              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "scheduled_at": {
              "type": "string",
              "format": "date-time"
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "meeting_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            },
            "run_notes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 20000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
