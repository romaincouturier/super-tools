      {
        "name": "update_live_meeting",
        "title": "Update a training live meeting",
        "description": "Updates only the provided fields of a live session and returns before/after. Adding a first replay_url behaves like the app screen: learners get the in-app \"replay available\" notification and a replay post is published in the course community. If the live stays \"scheduled\" with a replay, the response proposes setting status to \"completed\" (call again to apply). Changing scheduled_at reschedules the 6-hour reminder emails like the app. No other email is sent.",
        "annotations": {
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "live_meeting_id": {
